rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // We might need to list experts
      
      function isValidUser(data) {
        return data.uid == request.auth.uid 
          && data.email is string && data.email.size() > 0
          && (!('role' in data) || data.role in ['user', 'expert', 'admin']);
      }

      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'role', 'updatedAt']);
    }

    // --- Claims ---
    match /claims/{claimId} {
      allow get: if true; // Publicly readable
      allow list: if true;

      function isValidClaim(data) {
        return data.text is string && data.text.size() > 0 && data.text.size() < 5000
          && data.verdict in ['True', 'False', 'Misleading', 'Needs Context']
          && data.trustScore is number && data.trustScore >= 0 && data.trustScore <= 100;
      }

      // Only experts or admins can create/update verified claims in a real app
      // For this demo, we'll allow any signed-in user to create, but maybe only owners to update
      allow create: if isSignedIn() && isValidClaim(incoming()) && incoming().authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        // Owner update
        (existing().authorId == request.auth.uid && isValidClaim(incoming()) && incoming().authorId == existing().authorId)
        // || isAdmin() // If we had admin logic
      );
      allow delete: if false; // Soft delete preferred
    }

    // --- Consensus ---
    match /claims/{claimId}/consensus/{expertId} {
      allow get, list: if true;
      
      function isValidConsensus(data) {
        return data.expertId == request.auth.uid
          && data.stance in ['Agree', 'Disagree', 'Neutral']
          && data.notes is string && data.notes.size() < 2000;
      }

      allow create: if isOwner(expertId) && isValidConsensus(incoming());
      allow update: if isOwner(expertId) && isValidConsensus(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['stance', 'notes']);
    }

    // --- Verifications ---
    match /verifications/{verificationId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      function isValidVerification(data) {
        return data.userId == request.auth.uid
          && data.fullName is string && data.fullName.size() > 0
          && data.licenseNo is string && data.licenseNo.size() > 0
          && data.institution is string && data.institution.size() > 0
          && data.status == 'pending';
      }

      allow create: if isSignedIn() && isValidVerification(incoming());
      allow update, delete: if false; // Board only
    }
  }
}
